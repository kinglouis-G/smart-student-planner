#:kivy 2.1.0

<PlannerScreenManager>:
    LoginScreen:
        name: "login"
    DashboardScreen:
        name: "dashboard"
    AddTaskScreen:
        name: "add_task"
    TaskDetailScreen:
        name: "task_detail"


<LoginScreen>:
    canvas.before:
        Color:
            rgba: 0.94, 0.98, 0.92, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(10)

        Label:
            text: "Smart Student Planner"
            font_size: "24sp"
            size_hint_y: None
            height: self.texture_size[1] + dp(10)

        Label:
            text: "Login"
            font_size: "20sp"
            size_hint_y: None
            height: self.texture_size[1] + dp(10)

        TextInput:
            id: username_input
            hint_text: "Username"
            size_hint_y: None
            height: dp(40)
            on_text: root.clear_error()

        TextInput:
            id: password_input
            hint_text: "Password"
            password: True
            size_hint_y: None
            height: dp(40)
            on_text: root.clear_error()

        Label:
            text: root.error_message
            color: 1, 0, 0, 1
            size_hint_y: None
            height: dp(20)

        Button:
            text: "Login"
            size_hint_y: None
            height: dp(45)
            background_normal: ""
            background_color: 0.145, 0.827, 0.404, 1
            color: 1, 1, 1, 1
            on_release:
                root.attempt_login(username_input.text, password_input.text)

        Button:
            text: "Create account"
            size_hint_y: None
            height: dp(40)
            background_normal: ""
            background_color: 0.094, 0.467, 0.949, 1
            color: 1, 1, 1, 1
            on_release:
                from kivy.factory import Factory
                popup = Factory.CreateUserPopup()
                popup.parent_screen = root
                popup.open()

        Widget:
            size_hint_y: 1


<DashboardScreen>:
    canvas.before:
        Color:
            rgba: 0.96, 0.97, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: 0.094, 0.467, 0.949, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            TextInput:
                id: search_input
                hint_text: "Search by title or module..."
                background_color: 1, 1, 1, 1
                multiline: False
                size_hint_x: 0.75
                on_text: root.on_search_query(root, self.text)

            Button:
                text: "Logout"
                size_hint_x: 0.25
                background_normal: ""
                background_color: 1, 1, 1, 1
                color: 0.094, 0.467, 0.949, 1
                on_release: root.logout()

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(4)

            Label:
                text: root.welcome_text
                font_size: "18sp"
                size_hint_y: None
                height: self.texture_size[1] + dp(8)
                color: 0.1, 0.1, 0.1, 1

            BoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(10)

                Label:
                    text: "Your Tasks"
                    font_size: "18sp"
                    size_hint_x: 0.7

                Button:
                    text: "Add Task"
                    size_hint_x: 0.3
                    background_normal: ""
                    background_color: 0.094, 0.467, 0.949, 1
                    color: 1, 1, 1, 1
                    on_release: root.open_add_task()

        ScrollView:
            do_scroll_x: False

            BoxLayout:
                id: tasks_container
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(5)
                padding: 0, 0, 0, dp(10)

        Label:
            text: "Tip: Tap a task to view details."
            size_hint_y: None
            height: dp(20)
            font_size: "12sp"
            color: 0.4, 0.4, 0.4, 1


<TaskListItem>:
    size_hint_y: None
    height: dp(70)
    background_normal: ""
    background_color: 0, 0, 0, 0

    on_release:
        if self.open_detail_callback: self.open_detail_callback(self.task_id)

    canvas.before:
        Color:
            rgba: root.card_color
        RoundedRectangle:
            radius: [dp(6), dp(6), dp(6), dp(6)]
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(8)
        spacing: dp(4)

        BoxLayout:
            spacing: dp(5)
            Label:
                text: "[b]" + root.title + "[/b]"
                markup: True
            Label:
                text: "Due: " + root.due_date
                font_size: "12sp"
                size_hint_x: None
                width: dp(110)

        BoxLayout:
            spacing: dp(5)
            Label:
                text: root.module
                font_size: "12sp"
                color: 0.1, 0.1, 0.1, 1
            Label:
                text: "Priority: " + root.priority
                font_size: "12sp"
                size_hint_x: None
                width: dp(110)

        Label:
            text: "Completed" if root.is_completed else "Not completed"
            font_size: "12sp"
            color: (0, 0.6, 0, 1) if root.is_completed else (0.6, 0, 0, 1)
            size_hint_y: None
            height: dp(16)


<AddTaskScreen>:
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height # this enables page scrolling
            padding: dp(10)
            spacing: dp(10)

            Label:
                text: "Edit Task" if root.is_edit_mode else "Add New Task"
                font_size: "20sp"
                size_hint_y: None
                height: dp(30)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

                TextInput:
                    id: title_input
                    hint_text: "Title"
                    size_hint_y: None
                    height: dp(40)
                    multiline: False

                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(10)

                    Spinner:
                        id: module_spinner
                        text: "Math"
                        values: ["Math", "Science", "English", "Business", "Other"]
                        size_hint_x: 0.55
                        size_hint_y: None
                        height: dp(40)
                        on_text: root.on_module_selected(self.text)

                    TextInput:
                        id: module_input
                        hint_text: "Other module"
                        size_hint_x: 0.45
                        size_hint_y: None
                        height: dp(40)
                        multiline: False
                        disabled: True
                        opacity: 0

                TextInput:
                    id: due_date_input
                    hint_text: "Due date (YYYY-MM-DD)"
                    size_hint_y: None
                    height: dp(40)
                    multiline: False

                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(10)

                    Button:
                        text: "Upload image"
                        background_normal: ""
                        background_color: 0.145, 0.827, 0.404, 1
                        color: 1, 1, 1, 1
                        on_release: root.open_image_picker()

                    Button:
                        text: "Use camera"
                        background_normal: ""
                        background_color: 0.094, 0.467, 0.949, 1
                        color: 1, 1, 1, 1
                        on_release: root.open_camera()

                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(10)

                    Label:
                        text: "Task color:"
                        size_hint_x: None
                        width: dp(90)
                        color: 0.15, 0.15, 0.15, 1

                    Spinner:
                        id: color_spinner
                        text: root.color_name
                        values: ["Default", "WhatsApp Green", "Facebook Blue", "Yellow", "Red"]
                        size_hint_y: None
                        height: dp(40)
                        on_text: root.on_color_selected(self.text)

                Label:
                    id: image_path_label
                    text: root.image_path or "No image selected"
                    size_hint_y: None
                    height: dp(20)
                    font_size: "12sp"
                    color: 0.4, 0.4, 0.4, 1
                    text_size: self.size
                    halign: "left"
                    valign: "middle"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(200)
                    padding: dp(4)
                    canvas.before:
                        Color:
                            rgba: 0.85, 0.85, 0.85, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    Image:
                        id: image_preview
                        source: root.image_path
                        allow_stretch: True
                        keep_ratio: True
                        size_hint: 1, 1

                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(10)

                    Label:
                        text: "Priority:"
                        size_hint_x: None
                        width: dp(80)

                    Spinner:
                        id: priority_spinner
                        text: "Medium"
                        values: ["Low", "Medium", "High"]
                        size_hint_y: None
                        height: dp(40)

                    Label:
                        text: "Completed:"
                        size_hint_x: None
                        width: dp(80)

                    CheckBox:
                        id: completed_checkbox
                        size_hint_x: None
                        width: dp(40)

                Label:
                    text: "Notes:"
                    size_hint_y: None
                    height: dp(20)
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: notes_input
                    hint_text: "Optional notes..."
                    multiline: True
                    size_hint_y: None
                    height: dp(100)

            Label:
                text: root.error_message
                color: 1, 0, 0, 1
                size_hint_y: None
                height: dp(20)

            BoxLayout:
                size_hint_y: None
                height: dp(45)
                spacing: dp(10)

                Button:
                    text: "Cancel"
                    background_normal: ""
                    background_color: 0.6, 0.6, 0.6, 1
                    color: 1, 1, 1, 1
                    on_release: root.cancel()

                Button:
                    text: "Save"
                    background_normal: ""
                    background_color: 0.094, 0.467, 0.949, 1
                    color: 1, 1, 1, 1
                    on_release: root.submit_form()


<TaskDetailScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        Label:
            text: "Task Details"
            font_size: "20sp"
            size_hint_y: None
            height: dp(30)

        BoxLayout:
            orientation: "vertical"
            spacing: dp(5)

            Label:
                text: "[b]Title:[/b] " + root.title_text
                markup: True

            Label:
                text: "[b]Module:[/b] " + root.module_text
                markup: True

            Label:
                text: "[b]Due date:[/b] " + root.due_date_text
                markup: True

            Label:
                text: "[b]Priority:[/b] " + root.priority_text
                markup: True

            Label:
                text: "[b]Status:[/b] " + ("Completed" if root.is_completed else "Not completed")
                markup: True

            Label:
                text: "[b]Notes:[/b]\\n" + root.notes_text
                markup: True
                valign: "top"
            Label:
                text: "[b]Attached Image:[/b]"
                markup: True
                size_hint_y: None
                height: dp(20)

            Image:
                source: root.image_path
                size_hint_y: None
                height: dp(180)
                allow_stretch: True
                keep_ratio: True
        Label:
            text: root.info_message
            color: 1, 0, 0, 1
            size_hint_y: None
            height: dp(20)

        BoxLayout:
            size_hint_y: None
            height: dp(45)
            spacing: dp(10)

            Button:
                text: "Back"
                background_normal: ""
                background_color: 0.145, 0.827, 0.404, 1
                color: 1, 1, 1, 1
                on_release: root.back_to_dashboard()

            Button:
                text: "Toggle Complete"
                background_normal: ""
                background_color: 0.094, 0.467, 0.949, 1
                color: 1, 1, 1, 1
                on_release: root.toggle_completion()

        BoxLayout:
            size_hint_y: None
            height: dp(45)
            spacing: dp(10)

            Button:
                text: "Edit"
                background_normal: ""
                background_color: 0.094, 0.467, 0.949, 1
                color: 1, 1, 1, 1
                on_release: root.open_edit()

            Button:
                text: "Delete"
                background_normal: ""
                background_color: 0.8, 0.1, 0.1, 1
                color: 1, 1, 1, 1
                on_release:
                    app = App.get_running_app()
                    app.open_delete_confirmation(root)


<DeleteConfirmPopup@Popup>:
    title: "Confirm delete"
    size_hint: 0.8, 0.3
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        Label:
            text: "Are you sure you want to delete this task?"

        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)

            Button:
                text: "Cancel"
                on_release: root.dismiss()

            Button:
                text: "Delete"
                background_color: 0.8, 0.1, 0.1, 1
                on_release:
                    root.parent_task_detail.delete_task()
                    root.dismiss()


<CreateUserPopup@Popup>:
    title: "Create account"
    size_hint: 0.9, 0.6
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(10)

        TextInput:
            id: create_username_input
            hint_text: "Username"
            size_hint_y: None
            height: dp(40)

        TextInput:
            id: create_password_input
            hint_text: "Password"
            password: True
            size_hint_y: None
            height: dp(40)

        TextInput:
            id: create_password_confirm_input
            hint_text: "Confirm password"
            password: True
            size_hint_y: None
            height: dp(40)

        Label:
            text: (getattr(root, 'parent_screen', None).error_message) if getattr(root, 'parent_screen', None) else ""
            color: 1, 0, 0, 1
            size_hint_y: None
            height: dp(20)

        BoxLayout:
            size_hint_y: None
            height: dp(45)
            spacing: dp(10)

            Button:
                text: "Cancel"
                background_normal: ""
                background_color: 0.6, 0.6, 0.6, 1
                color: 1, 1, 1, 1
                on_release: root.dismiss()

            Button:
                text: "Create"
                background_normal: ""
                background_color: 0.094, 0.467, 0.949, 1
                color: 1, 1, 1, 1
                on_release:
                    root.parent_screen.create_user(create_username_input.text, create_password_input.text, create_password_confirm_input.text)
                    root.dismiss()

